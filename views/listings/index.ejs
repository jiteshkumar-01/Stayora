<% layout("/layouts/boilerplate") %>

<div class="container">

  <!-- ==========================================================================
       HERO SECTION (Shown on Homepage when not filtering by category or country)
       ========================================================================== -->
  <% if (!category && !country) { %>
    <section class="hero-section">
      <div class="hero-bg-overlay"></div>
      <div class="hero-content">
        <div class="hero-tagline">
          <i class="fa-solid fa-sparkles text-warning"></i> Premium Stays & Experiences
        </div>
        <h1 class="hero-title">Find your next unforgettable stay.</h1>
        <p class="hero-subtitle">Discover unique homes, luxury villas, beachfront retreats, and authentic places around the globe.</p>

        <!-- Floating Search Panel -->
        <form action="/listings/search" method="GET" class="hero-search-box">
          <div class="hero-search-field">
            <span class="hero-search-label">Where</span>
            <input type="text" name="country" class="hero-search-input-elem" placeholder="Search destinations (e.g. India, Italy)..." required>
          </div>
          <div class="hero-search-field d-none d-md-flex">
            <span class="hero-search-label">Check in</span>
            <input type="date" class="hero-search-input-elem text-muted" aria-label="Check in date">
          </div>
          <div class="hero-search-field d-none d-md-flex">
            <span class="hero-search-label">Guests</span>
            <input type="number" min="1" value="1" class="hero-search-input-elem" aria-label="Guests count">
          </div>
          <button type="submit" class="btn btn-primary-custom py-3 px-4 rounded-pill">
            <i class="fa-solid fa-magnifying-glass"></i> Search
          </button>
        </form>

        <div class="mt-3 text-white-50 small d-flex align-items-center gap-2">
          <i class="fa-solid fa-shield-halved text-success"></i> Thousands of verified unique stays waiting to be discovered.
        </div>
      </div>
    </section>
  <% } %>

  <!-- ==========================================================================
       CATEGORY / DISCOVERY NAVIGATION & TAX TOGGLE
       ========================================================================== -->
  <div class="category-bar-wrapper">
    
    <div class="categories-container" id="categoryNav">
      <a href="/listings" class="category-item <%= !category ? 'active' : '' %>">
        <i class="fa-solid fa-compass"></i>
        <span>All Stays</span>
      </a>
      <a href="/listings/category/Trending" class="category-item <%= (category === 'Trending') ? 'active' : '' %>">
        <i class="fa-solid fa-fire text-danger"></i>
        <span>Trending</span>
      </a>
      <a href="/listings/category/Rooms" class="category-item <%= (category === 'Rooms') ? 'active' : '' %>">
        <i class="fa-solid fa-bed"></i>
        <span>Rooms</span>
      </a>
      <a href="/listings/category/Cities" class="category-item <%= (category === 'Cities') ? 'active' : '' %>">
        <i class="fa-solid fa-city"></i>
        <span>Cities</span>
      </a>
      <a href="/listings/category/Mountain" class="category-item <%= (category === 'Mountain') ? 'active' : '' %>">
        <i class="fa-solid fa-mountain"></i>
        <span>Mountains</span>
      </a>
      <a href="/listings/category/Castles" class="category-item <%= (category === 'Castles') ? 'active' : '' %>">
        <i class="fa-solid fa-chess-rook"></i>
        <span>Castles</span>
      </a>
      <a href="/listings/category/Pools" class="category-item <%= (category === 'Pools') ? 'active' : '' %>">
        <i class="fa-solid fa-person-swimming"></i>
        <span>Amazing Pools</span>
      </a>
      <a href="/listings/category/Lakes" class="category-item <%= (category === 'Lakes') ? 'active' : '' %>">
        <i class="fa-solid fa-water"></i>
        <span>Lakes</span>
      </a>
      <a href="/listings/category/Beach" class="category-item <%= (category === 'Beach') ? 'active' : '' %>">
        <i class="fa-solid fa-umbrella-beach"></i>
        <span>Beachfront</span>
      </a>
      <a href="/listings/category/Camping" class="category-item <%= (category === 'Camping') ? 'active' : '' %>">
        <i class="fa-solid fa-campground"></i>
        <span>Camping</span>
      </a>
      <a href="/listings/category/Domes" class="category-item <%= (category === 'Domes') ? 'active' : '' %>">
        <i class="fa-solid fa-igloo"></i>
        <span>Domes</span>
      </a>
      <a href="/listings/category/Arictic" class="category-item <%= (category === 'Arictic') ? 'active' : '' %>">
        <i class="fa-solid fa-snowflake"></i>
        <span>Arctic</span>
      </a>
      <a href="/listings/category/Boats" class="category-item <%= (category === 'Boats') ? 'active' : '' %>">
        <i class="fa-solid fa-sailboat"></i>
        <span>Boats</span>
      </a>
    </div>

    <!-- Tax Switch Toggle -->
    <div class="tax-toggle-box">
      <div class="form-check form-switch m-0 p-0 d-flex align-items-center gap-2">
        <input class="form-check-input ms-0" type="checkbox" role="switch" id="taxToggleSwitch">
        <label class="form-check-label" for="taxToggleSwitch">Display total before taxes</label>
      </div>
    </div>

  </div>

  <!-- Filter Context Header if filtering -->
  <% if (category) { %>
    <div class="d-flex align-items-center justify-content-between mb-4">
      <h3 class="fw-bold m-0"><%= category %> Stays</h3>
      <a href="/listings" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
        <i class="fa-solid fa-xmark me-1"></i> Clear filter
      </a>
    </div>
  <% } else if (country) { %>
    <div class="d-flex align-items-center justify-content-between mb-4">
      <h3 class="fw-bold m-0">Stays in "<%= country %>"</h3>
      <a href="/listings" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
        <i class="fa-solid fa-xmark me-1"></i> Clear search
      </a>
    </div>
  <% } %>

  <!-- ==========================================================================
       LISTING CARDS GRID
       ========================================================================== -->
  <% if (allListings && allListings.length > 0) { %>
    <div class="listing-grid">
      <% for (let i = 0; i < allListings.length; i++) { 
           let listing = allListings[i];
           let isWishlisted = (typeof wishlistIds !== 'undefined' && wishlistIds && listing && listing._id) 
             ? wishlistIds.includes(listing._id.toString()) 
             : false;
           let coverImg = (listing.images && listing.images.length > 0) 
             ? listing.images[0].url 
             : (listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=800&q=80');
      %>
        <div class="listing-card">
          <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
            <div class="card-img-wrapper">
              
              <!-- Guest Favourite Badge (for top rated/featured items) -->
              <% if (i % 3 === 0) { %>
                <div class="badge-guest-favourite">
                  <i class="fa-solid fa-star text-warning me-1"></i> Guest favourite
                </div>
              <% } %>

              <!-- Wishlist Heart Button -->
              <button type="button" class="wishlist-heart-btn <%= isWishlisted ? 'active' : '' %>" data-listing-id="<%= listing._id %>" title="<%= isWishlisted ? 'Remove from wishlist' : 'Save to wishlist' %>" onclick="event.preventDefault(); toggleWishlist('<%= listing._id %>', this);">
                <i class="<%= isWishlisted ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart' %>"></i>
              </button>

              <img src="<%= coverImg %>" 
                   alt="<%= listing.title %>" 
                   loading="lazy"
                   onerror="this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=800&q=80'">
            </div>

            <div class="card-info">
              <div class="card-title-row">
                <div class="card-location"><%= listing.location %>, <%= listing.country %></div>
                <div class="card-rating">
                  <i class="fa-solid fa-star"></i> 4.<%= 85 + (i % 14) %>
                </div>
              </div>
              <div class="card-title-sub"><%= listing.title %></div>
              <div class="card-title-sub text-muted small"><%= listing.category || 'Unique stay' %> · 2 beds</div>
              <div class="card-price-row">
                <span class="card-price-val">₹<%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %></span>
                <span class="text-muted fw-normal">night</span>
                <span class="card-tax-info ms-1">+18% GST</span>
              </div>
            </div>
          </a>
        </div>
      <% } %>
    </div>

  <% } else { %>
    <!-- Empty State -->
    <div class="text-center py-5 my-5">
      <div class="mb-4">
        <i class="fa-solid fa-house-circle-xmark display-1 text-muted opacity-50"></i>
      </div>
      <h3 class="fw-bold">No stays found</h3>
      <p class="text-muted max-w-md mx-auto">We couldn't find any listings matching your search criteria or category filter. Try clearing your search or browsing all stays.</p>
      <a href="/listings" class="btn btn-primary-custom rounded-pill mt-2">
        <i class="fa-solid fa-arrows-rotate me-1"></i> Explore all stays
      </a>
    </div>
  <% } %>

</div>
