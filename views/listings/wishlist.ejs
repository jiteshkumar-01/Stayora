<% layout("/layouts/boilerplate") %>

<div class="container py-4">

  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h2 class="fw-extrabold text-dark m-0">Your Wishlist</h2>
      <p class="text-muted m-0">Saved stays you love on Stayora.</p>
    </div>
    <a href="/listings" class="btn btn-outline-custom rounded-pill">
      <i class="fa-solid fa-compass me-1"></i> Explore more stays
    </a>
  </div>

  <% if (listings && listings.length > 0) { %>
    <div class="listing-grid">
      <% for (let i = 0; i < listings.length; i++) { 
           let listing = listings[i];
           if (!listing) continue;
           let coverImg = (listing.images && listing.images.length > 0) ? listing.images[0].url : (listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=800&q=80');
      %>
        <div class="listing-card">
          <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
            <div class="card-img-wrapper">
              
              <!-- Wishlist Heart Button (Active) -->
              <button type="button" class="wishlist-heart-btn active" data-listing-id="<%= listing._id %>" title="Remove from wishlist" onclick="event.preventDefault(); toggleWishlist('<%= listing._id %>', this);">
                <i class="fa-solid fa-heart text-danger"></i>
              </button>

              <img src="<%= coverImg %>" 
                   alt="<%= listing.title %>" 
                   loading="lazy"
                   onerror="this.src='https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=800&q=80'">
            </div>

            <div class="card-info">
              <div class="card-title-row">
                <div class="card-location"><%= listing.location %>, <%= listing.country %></div>
                <div class="card-rating">
                  <i class="fa-solid fa-star text-warning"></i> 4.92
                </div>
              </div>
              <div class="card-title-sub fw-bold"><%= listing.title %></div>
              <div class="card-title-sub text-muted small"><%= listing.category || 'Unique stay' %> · 2 beds</div>
              <div class="card-price-row mt-2">
                <span class="card-price-val">₹<%= listing.price ? listing.price.toLocaleString("en-IN") : '0' %></span>
                <span class="text-muted fw-normal">night</span>
              </div>
              <div class="d-flex align-items-center gap-2 mt-3 pt-2 border-top">
                <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-dark rounded-pill flex-grow-1 fw-semibold" onclick="event.stopPropagation();">
                  <i class="fa-solid fa-eye me-1"></i> View stay
                </a>
                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill fw-semibold" onclick="event.preventDefault(); event.stopPropagation(); toggleWishlist('<%= listing._id %>', this.closest('.listing-card').querySelector('.wishlist-heart-btn'));">
                  <i class="fa-solid fa-trash me-1"></i> Remove
                </button>
              </div>
            </div>
          </a>
        </div>
      <% } %>
    </div>

  <% } else { %>
    <!-- Wishlist Empty State -->
    <div class="text-center py-5 my-5 bg-white rounded-4 border p-5 shadow-sm">
      <div class="mb-4 text-danger opacity-75">
        <i class="fa-regular fa-heart display-1"></i>
      </div>
      <h3 class="fw-bold">Your wishlist is waiting</h3>
      <p class="text-muted max-w-md mx-auto mb-4">Save stays you love by tapping the heart icon, and they will appear here for easy booking.</p>
      <a href="/listings" class="btn btn-primary-custom rounded-pill px-4 py-3 fs-6 fw-bold">
        Explore stays
      </a>
    </div>
  <% } %>

</div>
