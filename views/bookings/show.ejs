<% layout("/layouts/boilerplate") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      
      <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
        
        <!-- Receipt Header -->
        <div class="bg-dark text-white p-4 p-md-5 d-flex align-items-center justify-content-between flex-wrap gap-3">
          <div>
            <div class="badge bg-success-subtle text-success fw-bold uppercase px-3 py-2 rounded-pill mb-2">
              <i class="fa-solid fa-circle-check me-1"></i> <%= booking.bookingStatus %>
            </div>
            <h2 class="fw-extrabold m-0 text-white">Reservation Summary</h2>
            <p class="text-white-50 m-0 small">Booking Ref ID: <%= booking._id %></p>
          </div>
          
          <button class="btn btn-outline-light rounded-pill px-3 py-2 small" onclick="window.print();">
            <i class="fa-solid fa-print me-1"></i> Print Receipt
          </button>
        </div>

        <div class="p-4 p-md-5">
          
          <!-- Property Overview -->
          <div class="d-flex align-items-center gap-4 pb-4 border-bottom">
            <% if (booking.listing && booking.listing.image && booking.listing.image.url) { %>
              <img src="<%= booking.listing.image.url %>" class="rounded-4 object-fit-cover shadow-sm" width="140" height="100" alt="<%= booking.listing.title %>">
            <% } %>
            <div>
              <h4 class="fw-bold text-dark mb-1"><%= booking.listing ? booking.listing.title : "Listing unavailable" %></h4>
              <% if (booking.listing) { %>
                <p class="text-muted small mb-2"><i class="fa-solid fa-location-dot me-1"></i> <%= booking.listing.location %>, <%= booking.listing.country %></p>
              <% } %>
              <div class="d-flex gap-3 small text-secondary">
                <span><b>Host:</b> <%= booking.host ? booking.host.username : "Host" %></span>
                <span><b>Guest:</b> <%= booking.user ? booking.user.username : "Guest" %></span>
              </div>
            </div>
          </div>

          <!-- Dates & Stay Details -->
          <div class="row my-4 g-3">
            <div class="col-md-6">
              <div class="bg-light p-3 rounded-3">
                <div class="text-muted small fw-semibold text-uppercase">Check-in Date</div>
                <div class="fw-bold fs-5 text-dark"><%= new Date(booking.checkIn).toLocaleDateString("en-IN", { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %></div>
              </div>
            </div>

            <div class="col-md-6">
              <div class="bg-light p-3 rounded-3">
                <div class="text-muted small fw-semibold text-uppercase">Check-out Date</div>
                <div class="fw-bold fs-5 text-dark"><%= new Date(booking.checkOut).toLocaleDateString("en-IN", { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %></div>
              </div>
            </div>
          </div>

          <!-- Price Breakdown Table -->
          <h5 class="fw-bold text-dark mb-3">Payment Breakdown</h5>
          <div class="bg-light rounded-3 p-3 mb-4">
            <div class="d-flex justify-content-between py-2 border-bottom text-secondary">
              <span>₹<%= booking.pricePerNight ? booking.pricePerNight.toLocaleString("en-IN") : 0 %> × <%= booking.totalNights %> nights</span>
              <span class="fw-semibold text-dark">₹<%= (booking.pricePerNight * booking.totalNights).toLocaleString("en-IN") %></span>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom text-secondary">
              <span>Guests</span>
              <span class="fw-semibold text-dark"><%= booking.guests %> guest(s)</span>
            </div>
            <div class="d-flex justify-content-between py-2 border-bottom text-secondary">
              <span>Payment ID</span>
              <span class="fw-semibold text-dark"><%= booking.razorpayPaymentId || 'Completed' %></span>
            </div>
            <div class="d-flex justify-content-between pt-3 fw-bold fs-5 text-dark">
              <span>Total Paid</span>
              <span class="text-primary">₹<%= Number(booking.totalAmount || 0).toLocaleString("en-IN") %></span>
            </div>
          </div>

          <% if (booking.bookingStatus === "cancelled" && booking.paymentStatus === "paid") { %>
            <div class="alert alert-warning border-0 rounded-3 small">
              <i class="fa-solid fa-triangle-exclamation me-1"></i> This booking has been cancelled. No automatic refund was issued; manual refund review is pending.
            </div>
          <% } %>

          <!-- Actions -->
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 pt-3">
            <a href="/bookings/my-bookings" class="btn btn-outline-dark rounded-pill px-4">
              <i class="fa-solid fa-arrow-left me-1"></i> Back to My Bookings
            </a>

            <% if (currUser && booking.user && currUser._id.equals(booking.user._id) && booking.bookingStatus !== "cancelled" && new Date(booking.checkIn) > new Date()) { %>
              <form method="POST" action="/bookings/<%= booking._id %>/cancel?_method=PATCH" onsubmit="return confirm('Cancel this booking? Note: No automatic refund will be issued.');">
                <button type="submit" class="btn btn-outline-danger rounded-pill px-4 fw-semibold">
                  Cancel Reservation
                </button>
              </form>
            <% } %>
          </div>

        </div>

      </div>

    </div>
  </div>
</div>
