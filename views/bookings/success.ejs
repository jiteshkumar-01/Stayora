<% layout("/layouts/boilerplate") %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      
      <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white text-center">
        
        <div class="mb-4">
          <div class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-circle p-4 mb-3 shadow-sm" style="width: 90px; height: 90px;">
            <i class="fa-solid fa-circle-check display-3"></i>
          </div>
          <h1 class="fw-extrabold text-dark mb-2">Your stay is confirmed!</h1>
          <p class="text-muted fs-6">Pack your bags! Your reservation has been placed successfully.</p>
        </div>

        <% if (booking.listing && booking.listing.image && booking.listing.image.url) { %>
          <div class="rounded-4 overflow-hidden shadow-sm mb-4" style="max-height: 320px;">
            <img src="<%= booking.listing.image.url %>" alt="<%= booking.listing.title %>" class="w-100 h-100 object-fit-cover">
          </div>
        <% } %>

        <h3 class="fw-bold text-dark mb-4"><%= booking.listing ? booking.listing.title : "Listing unavailable" %></h3>

        <div class="bg-light rounded-4 p-4 text-start mb-4">
          <div class="row g-3">
            <div class="col-md-6">
              <div class="text-muted small fw-semibold">Check-in</div>
              <div class="fw-bold text-dark fs-6"><%= new Date(booking.checkIn).toLocaleDateString("en-IN", { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %></div>
            </div>

            <div class="col-md-6">
              <div class="text-muted small fw-semibold">Check-out</div>
              <div class="fw-bold text-dark fs-6"><%= new Date(booking.checkOut).toLocaleDateString("en-IN", { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %></div>
            </div>

            <div class="col-md-4">
              <div class="text-muted small fw-semibold">Guests</div>
              <div class="fw-semibold text-dark"><%= booking.guests %> guest(s)</div>
            </div>

            <div class="col-md-4">
              <div class="text-muted small fw-semibold">Total Nights</div>
              <div class="fw-semibold text-dark"><%= booking.totalNights %> night(s)</div>
            </div>

            <div class="col-md-4">
              <div class="text-muted small fw-semibold">Amount Paid</div>
              <div class="fw-bold text-primary">₹<%= booking.totalAmount.toLocaleString("en-IN") %></div>
            </div>

            <div class="col-12 border-top pt-3">
              <span class="text-muted small">Payment ID:</span> 
              <code class="text-dark bg-white px-2 py-1 rounded border"><%= booking.razorpayPaymentId %></code>
            </div>
          </div>
        </div>

        <div class="d-flex align-items-center justify-content-center flex-wrap gap-3">
          <a href="/bookings/my-bookings" class="btn btn-primary-custom rounded-pill px-4 py-3">
            <i class="fa-solid fa-suitcase me-1"></i> View My Bookings
          </a>
          <a href="/listings" class="btn btn-outline-custom rounded-pill px-4 py-3">
            Explore more stays
          </a>
        </div>

      </div>

    </div>
  </div>
</div>
